{
  "name": "inv",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "docker:up": "docker compose -f docker-compose.dev.yml up -d",
    "docker:down": "docker compose -f docker-compose.dev.yml down",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:seed": "tsx src/db/seed.ts",
    "docker:prod:build": "docker compose -f docker-compose.yml build",
    "docker:prod:up": "docker compose -f docker-compose.yml up -d --build",
    "docker:prod:down": "docker compose -f docker-compose.yml down",
    "docker:prod:reset": "docker compose -f docker-compose.yml down -v",
    "docker:prod:logs": "docker compose -f docker-compose.yml logs -f web socket",
    "docker:prod:seed": "docker compose -f docker-compose.yml --profile seed run --rm seed",
    "prepare": "husky",
    "test": "jest",
    "server": "tsx server/index.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@hookform/resolvers": "^7.0.5",
    "@next/env": "^16.4.5",
    "@reduxjs/toolkit": "^2.14.0",
    "@serwist/next": "^9.5.13",
    "axios": "^1.21.0",
    "bootstrap": "^5.3.8",
    "dataloader": "^2.2.3",
    "drizzle-orm": "1.0.0-rc.5",
    "graphql": "^17.1.0",
    "graphql-yoga": "^6.0.1",
    "jose": "^6.2.17",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.70.0",
    "mysql2": "^3.24.6",
    "next": "16.4.5",
    "next-intl": "^4.14.9",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "^7.91.0",
    "react-leaflet": "^5.0.0",
    "react-redux": "^9.3.1",
    "recharts": "^3.10.1",
    "socket.io-client": "^4.8.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@serwist/turbopack": "^9.5.13",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "babel-plugin-react-compiler": "1.0.0",
    "clsx": "^2.1.1",
    "dotenv": "^18.0.10",
    "drizzle-kit": "1.0.0-rc.5",
    "esbuild": "^0.28.2",
    "eslint": "^9",
    "eslint-config-next": "16.4.5",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "jest": "^30.5.2",
    "jest-environment-jsdom": "^30.5.2",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "sass": "^1.108.1",
    "sass-embedded": "^1.108.1",
    "serwist": "^9.5.13",
    "ts-node": "^10.9.2",
    "tsx": "^4.23.15",
    "typescript": "^5"
  },
  "packageManager": "pnpm@12.18.0",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.18.0",
      "onFail": "download"
    }
  }
}
